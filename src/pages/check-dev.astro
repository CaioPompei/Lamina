---
/* Página TEMPORÁRIA de diagnóstico de overflow — apagar após o teste. */
---
<!doctype html>
<html><head><meta charset="utf-8" /></head>
<body style="margin:0;background:#111;color:#7CFC00;font:15px/1.5 Consolas,monospace;padding:12px">
<div id="out">medindo...</div>
<iframe id="fr" src="/centro" style="width:390px;height:700px;border:1px solid red;margin-top:8px"></iframe>
<script is:inline>
const log = [];
function measure(d, label) {
  const vw = d.documentElement.clientWidth, sw = d.documentElement.scrollWidth;
  log.push(label + ": vw=" + vw + " scrollWidth=" + sw + " " + (sw > vw ? "*** OVERFLOW ***" : "ok"));
  if (sw > vw) {
    for (const e of d.querySelectorAll("*")) {
      const r = e.getBoundingClientRect();
      if (r.width && r.right > vw + 1) {
        const cls = (typeof e.className === "string" ? e.className : (e.className.baseVal || "")).split(" ")[0];
        log.push("&nbsp;&nbsp;" + e.tagName + "." + cls + " right=" + Math.round(r.right) + " w=" + Math.round(r.width));
      }
    }
  }
}
window.onload = () => setTimeout(() => {
  try {
    const fr = document.getElementById("fr");
    const w = fr.contentWindow, d = fr.contentDocument;
    measure(d, "carga");
    w.scrollTo(0, 1200); w.dispatchEvent(new Event("scroll"));
    setTimeout(() => {
      measure(d, "rolado (wa-bar/header)");
      const t = d.querySelector("[data-nav-toggle]");
      if (t) t.click();
      setTimeout(() => {
        measure(d, "menu aberto");
        document.getElementById("out").innerHTML = log.join("<br>");
      }, 900);
    }, 900);
  } catch (err) { document.getElementById("out").textContent = "ERRO: " + err; }
}, 3500);
</script>
</body></html>
