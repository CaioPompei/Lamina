---
/* Cabeçalho SEO reaproveitável: meta, Open Graph e JSON-LD. */
interface Props {
  title: string;
  description: string;
  image?: string;
  /** Um objeto ou lista de objetos JSON-LD (schema.org). */
  jsonLd?: object | object[];
}
const { title, description, image = "/og.jpg", jsonLd } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta name="theme-color" content="#1d1712" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Lâmina — Clube de Barbearia" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  blocks.map((b) => (
    <script type="application/ld+json" set:html={JSON.stringify(b)} />
  ))
}
