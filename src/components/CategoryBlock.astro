---
/* Uma categoria do cardápio (ex.: Cortes) como GALERIA de fotos.
   Cada serviço é um card com foto + nome; o card inteiro leva ao WhatsApp
   para agendar aquele serviço. Preço NÃO aparece no site (só no atendimento).
   Reaproveitável p/ outro nicho (Categoria de trajes → itens com foto). */
import { brand } from "@/brand";
import { whatsappLink } from "@/site";

interface Item {
  name: string;
  description?: string;
  meta?: string;
  price?: string;
  image?: string;
}
interface Props {
  name: string;
  slug: string;
  blurb?: string;
  items: Item[];
  /** WhatsApp da unidade (DDI+DDD, só dígitos) p/ montar o agendamento. */
  whatsapp?: string;
  /** Rótulo da unidade (bairro) usado na mensagem. */
  unitLabel?: string;
}
const { name, slug, blurb, items, whatsapp, unitLabel } = Astro.props;

const bookHref = (service: string) =>
  whatsappLink(
    `Olá, ${brand.name}${unitLabel ? " " + unitLabel : ""}! Gostaria de agendar: ${service}.`,
    whatsapp,
  );
const FALLBACK = "/fotos/oficio.svg";
---

<section class="cat" id={slug}>
  <header class="cat__head" data-reveal>
    <h3 class="cat__name">{name}</h3>
    {blurb && <p class="cat__blurb">{blurb}</p>}
  </header>

  <ul class="cat__grid">
    {
      items.map((it) => (
        <li class="scard" data-reveal>
          <a
            class="scard__link"
            href={bookHref(it.name)}
            target="_blank"
            rel="noopener"
            aria-label={`Agendar ${it.name} no WhatsApp`}
          >
            <img
              class="scard__img"
              src={it.image ?? FALLBACK}
              alt=""
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
            <span class="scard__body">
              <span class="scard__name">{it.name}</span>
              <span class="scard__cta">
                Agendar <span class="scard__arrow" aria-hidden="true">→</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cat {
    padding-block: clamp(2rem, 5vw, 3.25rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .cat__head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 46ch;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .cat__name {
    font-size: var(--step-2);
  }
  .cat__blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* ------------------------------ galeria ------------------------------ */
  .cat__grid {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 46rem) {
    .cat__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .cat__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .scard__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--carvao-2);
  }
  .scard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* scrim quente p/ o nome sempre legível sobre a foto */
  .scard__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    padding: clamp(0.8rem, 2vw, 1.1rem);
    background: linear-gradient(
      to top,
      rgba(18, 13, 9, 0.86) 0%,
      rgba(18, 13, 9, 0.35) 42%,
      rgba(18, 13, 9, 0) 72%
    );
  }
  .scard__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.05;
    color: var(--bone);
  }
  .scard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--latao-2);
  }
  .scard__arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  /* hover/foco: foto aproxima, seta desliza, fio de latão no contorno */
  .scard__link:hover .scard__img,
  .scard__link:focus-visible .scard__img {
    transform: scale(1.06);
  }
  .scard__link:hover .scard__arrow,
  .scard__link:focus-visible .scard__arrow {
    transform: translateX(4px);
  }
  .scard__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition: border-color 0.2s ease;
  }
  .scard__link:hover::after,
  .scard__link:focus-visible::after {
    border-color: color-mix(in srgb, var(--latao) 55%, transparent);
  }
  .scard__link:focus-visible {
    outline: 2px solid var(--latao);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .scard__img,
    .scard__arrow {
      transition: none;
    }
    .scard__link:hover .scard__img,
    .scard__link:focus-visible .scard__img {
      transform: none;
    }
  }
</style>
