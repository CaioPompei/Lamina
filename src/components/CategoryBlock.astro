---
/* Uma categoria do cardápio (ex.: Cortes) com seus itens em estilo
   "menu de preços": nome … preço, com descrição e duração abaixo.
   Reaproveitável p/ outro nicho (Categoria de trajes → itens). */
interface Item {
  name: string;
  description?: string;
  meta?: string;
  price?: string;
}
interface Props {
  name: string;
  slug: string;
  blurb?: string;
  items: Item[];
}
const { name, slug, blurb, items } = Astro.props;
---

<section class="cat" id={slug}>
  <header class="cat__head">
    <h3 class="cat__name">{name}</h3>
    {blurb && <p class="cat__blurb">{blurb}</p>}
  </header>

  <ul class="cat__list">
    {
      items.map((it) => (
        <li class="svc">
          <div class="svc__row">
            <span class="svc__name">{it.name}</span>
            <span class="svc__dots" aria-hidden="true" />
            {it.price && <span class="svc__price">{it.price}</span>}
          </div>
          {(it.description || it.meta) && (
            <div class="svc__sub">
              <span class="svc__desc">{it.description}</span>
              {it.meta && <span class="svc__time">{it.meta}</span>}
            </div>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cat {
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .cat__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .cat__name {
    font-size: var(--step-2);
  }
  .cat__blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 38ch;
  }
  .cat__list {
    display: grid;
    gap: 1.25rem;
  }
  .svc__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .svc__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
  }
  .svc__dots {
    flex: 1;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 35%, transparent);
    transform: translateY(-0.15em);
    min-width: 1.5rem;
  }
  .svc__price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--oxblood);
    white-space: nowrap;
  }
  .svc__sub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.3rem;
  }
  .svc__desc {
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 52ch;
  }
  .svc__time {
    color: var(--ink-soft);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.85;
  }
</style>
