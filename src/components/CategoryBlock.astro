---
/* Uma categoria do cardápio (ex.: Cortes) num spread editorial de duas
   colunas: trilho esquerdo (nome + blurb, sticky no desktop) e a lista de
   serviços à direita, no estilo "menu de preços" (nome · duração … preço).
   Reaproveitável p/ outro nicho (Categoria de trajes → itens). */
interface Item {
  name: string;
  description?: string;
  meta?: string;
  price?: string;
}
interface Props {
  name: string;
  slug: string;
  blurb?: string;
  items: Item[];
}
const { name, slug, blurb, items } = Astro.props;
---

<section class="cat" id={slug}>
  <header class="cat__head">
    <h3 class="cat__name">{name}</h3>
    {blurb && <p class="cat__blurb">{blurb}</p>}
  </header>

  <ul class="cat__list">
    {
      items.map((it) => (
        <li class="svc">
          <div class="svc__row">
            <span class="svc__name">{it.name}</span>
            {it.meta && <span class="svc__time">{it.meta}</span>}
            <span class="svc__dots" aria-hidden="true" />
            {it.price && <span class="svc__price">{it.price}</span>}
          </div>
          {it.description && <p class="svc__desc">{it.description}</p>}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cat {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  @media (min-width: 48rem) {
    .cat {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.75fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
    .cat__head {
      position: sticky;
      top: 1.5rem;
    }
  }
  .cat__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cat__name {
    font-size: var(--step-2);
  }
  .cat__blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 30ch;
  }

  .cat__list {
    display: grid;
    gap: 1.1rem;
  }
  .svc__row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .svc__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
  }
  .svc__time {
    color: var(--ink-soft);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.8;
  }
  .svc__dots {
    flex: 1;
    border-bottom: 1px dotted color-mix(in srgb, var(--ink) 35%, transparent);
    transform: translateY(-0.15em);
    min-width: 1.5rem;
  }
  .svc__price {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--oxblood);
    white-space: nowrap;
  }
  .svc__desc {
    color: var(--ink-soft);
    font-size: var(--step--1);
    max-width: 52ch;
    margin-top: 0.3rem;
  }
</style>
