---
import { brand } from "@/brand";
import { site, whatsappLink, telLink, mapLink } from "@/site";
import { getUnits, unitSlug, unitIndex } from "@/lib/units";

const units = await getUnits();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="wordmark" href="/">
          <span class="wordmark__name">{brand.name}</span>
          <span class="wordmark__dot" aria-hidden="true"></span>
        </a>
        <p class="site-footer__tag">{brand.tagline}</p>
        {
          site.social.instagram && (
            <a class="site-footer__ig" href={site.social.instagram} target="_blank" rel="noopener">
              <svg class="site-footer__ig-icon" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.2" />
                <circle cx="12" cy="12" r="4.6" />
                <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" stroke="none" />
              </svg>
              Instagram ↗
            </a>
          )
        }
      </div>

      <ul class="site-footer__units">
        {
          units.map((u) => (
            <li>
              <a class="site-footer__unit-name" href={`/${unitSlug(u)}`}>
                <span class="index-num" aria-hidden="true">{unitIndex(u)}</span>
                {u.data.name}
              </a>
              <a href={mapLink(u.data.mapQuery)} target="_blank" rel="noopener">
                {u.data.address}
              </a>
              <a href={telLink(u.data.phone)}>{u.data.phone}</a>
              <a
                class="site-footer__wa"
                href={whatsappLink(`Olá, ${brand.name} ${u.data.neighborhood}! Quero agendar.`, u.data.whatsapp)}
                target="_blank"
                rel="noopener"
              >
                WhatsApp
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <hr class="hairline" />

    <div class="site-footer__bottom">
      {
        brand.concept && (
          <p class="site-footer__concept">
            Projeto conceito — marca fictícia criada para demonstração de portfólio.
            Não é um estabelecimento real.
          </p>
        )
      }
      <p class="site-footer__legal">
        © {year} {brand.name}. Site criado por Caio Pompei.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--carvao-2);
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid color-mix(in srgb, var(--latao) 22%, transparent);
  }
  .site-footer__top {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 48rem) {
    .site-footer__top {
      grid-template-columns: 1fr 2fr;
      gap: 3rem;
    }
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .wordmark__dot {
    width: 7px;
    height: 7px;
    background: var(--latao);
    transform: translateY(-0.1em);
  }
  .site-footer__tag {
    margin-top: 0.75rem;
    color: var(--bone-soft);
    max-width: 22ch;
  }
  .site-footer__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.25rem;
    color: var(--latao-2);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    transition: color 0.18s ease;
  }
  .site-footer__ig:hover {
    color: var(--bone);
  }
  .site-footer__ig-icon {
    flex: none;
    width: 1.15em;
    height: 1.15em;
  }
  .site-footer__units {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 34rem) {
    .site-footer__units {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .site-footer__units li {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--bone-soft);
    line-height: 1.45;
  }
  .site-footer__units a:hover {
    color: var(--bone);
  }
  .site-footer__unit-name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--bone);
    margin-bottom: 0.25rem;
  }
  .site-footer__unit-name .index-num {
    font-size: 0.85rem;
  }
  .site-footer__wa {
    color: var(--latao-2) !important;
    font-weight: 600;
  }
  .hairline {
    margin-block: 2.5rem;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
    color: var(--bone-soft);
  }
  .site-footer__concept {
    max-width: 52ch;
    color: var(--latao-2);
    opacity: 0.85;
  }
</style>
